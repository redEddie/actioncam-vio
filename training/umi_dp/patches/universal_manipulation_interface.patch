+    horizon: ${task.action_horizon}
+    latency_steps: 0 # float
+    down_sample_steps: ${task.obs_down_sample_steps} # int
+    rotation_rep: rotation_6d
+
+task_name: &task_name umi_gopro
+dataset_path: /home/jeonchanwook/work/umi_dp/data/gopro_umi_202608161903.zarr.zip
+pose_repr: &pose_repr
